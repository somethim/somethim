# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# PostgreSQL 18. Matches the credentials in compose.yaml for local work.
DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:5432/portfolio

# Origin the admin is served from. Passkeys are bound to it, so it must match
# the address in the browser's URL bar exactly — scheme, host, and port.
# Production: https://arbikullakshi.com
WEBAUTHN_ORIGIN=http://localhost:3000

# Where the server listens. Overrides site-addr from Cargo.toml.
LEPTOS_SITE_ADDR=127.0.0.1:3000

# Serves the compiled bundle in production; cargo-leptos sets it in dev.
LEPTOS_SITE_ROOT=target/site

# Transactional email (comment replies, verification codes). Unset in
# development — sending is skipped rather than failing.
RESEND_API_KEY=
