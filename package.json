{
  "name": "zennweb",
  "private": true,
  "author": {
    "name": "zennit",
    "email": "zennit.dev@gmail.com",
    "url": "https://www.zennit.dev/"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=./apps/web...",
    "build:mobile": "turbo run build --filter=./apps/mobile...",
    "build:packages": "turbo build --filter=@zenncore/*",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=./apps/web...",
    "dev:mobile": "turbo run dev --filter=./apps/mobile...",
    "dev:packages": "turbo dev --filter=@zenncore/*",
    "lint": "biome lint --write --unsafe",
    "typecheck": "turbo run typecheck",
    "outdated": "turbo run outdated && bun outdated -r",
    "clean": "turbo run clean && rm -rf node_modules bun.lockb .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@turbo/gen": "^2.7.6"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@vercel/analytics": "^2.0.1",
    "turbo": "^2.7.6"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/shared/*"
    ],
    "catalog": {
      "@hookform/resolvers": "^5.2.2",
      "@tailwindcss/postcss": "^4.1.18",
      "@types/node": "^24.10.4",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.3",
      "react-hook-form": "^7.69.0",
      "tailwindcss": "^4.1.18",
      "tsdown": "^0.20.3",
      "typescript": "^5.9.3",
      "zod": "^4.2.1",
      "date-fns": "^4.1.0"
    }
  }
}
