{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "allFeatures": true
        },
        "check": {
          "command": "clippy",
          "extraArgs": [
            "--",
            "-D",
            "clippy::pedantic",
            "-D",
            "clippy::nursery",
            "-D",
            "clippy::unwrap_used"
          ]
        }
      }
    }
  }
}
